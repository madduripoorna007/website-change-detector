PORT=3000
BASE_URL=http://localhost:3000
MONGO_URL=mongodb://localhost:27017/changedetector
REDIS_URL=redis://localhost:6379
DATA_DIR=./data

# SSRF protection blocks every private/loopback/link-local/metadata address.
# For the local demo store ONLY, allow exact host:port pairs (comma separated). Keep empty in production.
PRIVATE_HOST_ALLOWLIST=
# Use a system Chromium instead of Playwright's download (optional; the Docker image sets this itself)
# CHROMIUM_PATH=/usr/bin/chromium

# Sessions (set COOKIE_SECURE=true when served over HTTPS)
SESSION_DAYS=14
COOKIE_SECURE=false

# Politeness
PER_DOMAIN_GAP_MS=10000
WORKER_CONCURRENCY=3
USER_AGENT=ChangeDetectorBot/1.0 (+https://github.com/madduripoorna007/website-change-detector)

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Change Detector <alerts@example.com>

# Telegram (optional, per-watch chat id is set in the UI)
TELEGRAM_BOT_TOKEN=

# AI one-line summaries (optional, any OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Daily digest hour in UTC (3 = 08:30 IST)
DIGEST_HOUR_UTC=3
