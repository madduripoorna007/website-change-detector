  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bullmq": "^5.34.0",
    "cheerio": "^1.0.0",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "mongoose": "^8.5.1",
    "nodemailer": "^6.9.14",
    "pixelmatch": "^5.3.0",
    "playwright": "1.48.2",
    "pngjs": "^7.0.0"
  }
}
