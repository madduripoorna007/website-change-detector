{
  "name": "website-change-detector",
  "version": "1.0.0",
  "description": "Monitors public web pages and alerts on meaningful changes while ignoring noise",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node src/server.js & node src/worker.js",
